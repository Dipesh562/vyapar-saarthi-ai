# Production Environment Configuration Example
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-strong-random-secret-key-here

# Database URL (SQLite default or PostgreSQL/MySQL cloud URL e.g., Supabase / PlanetScale / Railway)
DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Credentials (For WhatsApp & SMS Receipt Delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Sentry Monitoring DSN
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

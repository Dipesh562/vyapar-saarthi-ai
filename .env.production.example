# Production Environment Configuration
# Copy to .env and fill in real values before deploying.

FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-strong-random-secret-key-here

# Database URL — any standard PostgreSQL connection string works.
# Examples:
#   Supabase:  postgresql://postgres:your_password@db.supabase.co:5432/postgres
#   Railway:   postgresql://postgres:password@host.railway.app:5432/railway
#   Render:    postgresql://user:password@host.render.com:5432/dbname
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Seed demo inventory on first boot (set to false after first deployment)
SEED_DEMO=true

# Voice pipeline mode: 'ai_first' (recommended) or 'legacy'
VOICE_PIPELINE_MODE=ai_first

# Google Gemini API Key
# Used for: (1) Primary AI NLP intent parsing, (2) Speech-to-Text audio transcription
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (optional, used as NLP fallback if Gemini fails)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio (optional — enables SMS/WhatsApp receipt delivery to customers)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Sentry (optional — enables production error monitoring & alerting)
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

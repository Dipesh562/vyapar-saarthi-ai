FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
# Supported DB formats:
#   SQLite (default for local dev): sqlite:///vyapar_saarthi_dev.db
#   PostgreSQL: postgresql://user:password@host:5432/dbname
#   MySQL: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///vyapar_saarthi_dev.db
SEED_DEMO=true

# AI Keys (optional — app runs without them using regex fallback for NLP; STT requires Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Voice pipeline mode: 'ai_first' (default) or 'legacy'
VOICE_PIPELINE_MODE=ai_first

# Twilio (optional — only needed for SMS/WhatsApp receipt delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Sentry (optional — only needed for production error monitoring)
# SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0
